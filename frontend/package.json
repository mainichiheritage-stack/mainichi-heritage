{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:cloudflare": "concurrently \"npm run dev\" \"npm run build:cloudflare -- --watch\"",
    "build": "next build",
    "build:cloudflare": "open-next build",
    "build:cloudflare:watch": "open-next build --watch",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@tailwindcss/typography": "^0.5.19",
    "lucide-react": "^0.577.0",
    "next": "^15.5.2",
    "next-axiom": "^1.10.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.37",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "concurrently": "^8.2.2",
    "eslint": "^9",
    "eslint-config-next": "^15.5.2",
    "open-next": "^3.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.90.1"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-win32-x64-msvc": "^4.2.1",
    "lightningcss-win32-x64-msvc": "^1.31.1"
  }
}
